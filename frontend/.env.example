# The dashboard reaches the Go backend through the same-origin BFF proxy
# (/api/v1/...), so there is no public API URL to configure: the backend
# address is a server-side variable (INTERNAL_API_URL) and is never sent to
# the browser.

# Max bytes the BFF proxy will buffer from the Go backend per response.
# Default 52428800 (50 MiB). Software/compliance payloads can be large, but
# this caps memory use if a backend response balloons.
# BFF_MAX_RESPONSE_BYTES=52428800

# Max bytes the BFF proxy will accept from the browser per request.
# Default 10485760 (10 MiB). Larger bodies are rejected with HTTP 413.
# BFF_MAX_REQUEST_BYTES=10485760

# Timeout in milliseconds for a single backend call through the BFF proxy.
# A timed-out call answers HTTP 504. Default 30000.
# BFF_TIMEOUT_MS=30000

# Timeout in milliseconds for the Keycloak token refresh call.
# Default 10000.
# AUTH_REFRESH_TIMEOUT_MS=10000
