# In production this MUST be https:// — the app fails closed otherwise.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Max bytes the BFF proxy will buffer from the Go backend per response.
# Default 52428800 (50 MiB). Software/compliance payloads can be large, but
# this caps memory use if a backend response balloons.
# BFF_MAX_RESPONSE_BYTES=52428800
